# MedLevo AI — example configuration. Copy to .env (never commit .env).
# No real secrets belong in this file or in the repository.

# Where the server stores the SQLite database, private files and job artifacts.
MEDLEVO_DATA_DIR=./data

# HTTP
MEDLEVO_HOST=127.0.0.1
MEDLEVO_PORT=8787
# Public origin of the web app (used for CORS/CSRF origin checks). Several may be listed, comma-separated (the first is
# canonical). Empty, or "auto", on Render: the address Render gives the service (RENDER_EXTERNAL_URL) is used.
MEDLEVO_ORIGIN=http://localhost:5173

# Session cookie Secure flag. Defaults to true when MEDLEVO_ORIGIN is https, false otherwise.
MEDLEVO_COOKIE_SECURE=

# First-run setup token (claiming the single owner account). Required when the server listens on a non-loopback
# address, trusts a proxy (MEDLEVO_TRUST_PROXY), has a non-loopback MEDLEVO_ORIGIN, or when this value is set.
# Leave empty to have the server print a one-time token to its log at boot (it is never stored; a restart prints a
# new one). Set your own long random value here to choose it yourself. It is only checked until the owner exists.
MEDLEVO_SETUP_TOKEN=

# Upload limits
MEDLEVO_MAX_UPLOAD_MB=200
MEDLEVO_MAX_ZIP_ENTRIES=500
MEDLEVO_MAX_ZIP_UNCOMPRESSED_MB=1024

# Default display timezone (storage is always UTC epoch ms)
MEDLEVO_TIMEZONE=Asia/Baghdad

# --- AI providers (optional). Leave empty to keep AI features disabled. ---
# Keys are read only on the server. They are never sent to the browser,
# stored in the database, written to logs, or included in exports/backups.
ANTHROPIC_API_KEY=
# Optional per-task model overrides (see Control Center → Intelligence)
MEDLEVO_MODEL_GENERATION=
MEDLEVO_MODEL_VERIFICATION=
MEDLEVO_MODEL_VISION=

# Monthly AI budget guard in USD (estimated cost). 0 = AI calls blocked.
MEDLEVO_AI_MONTHLY_BUDGET_USD=20

# External fetching (image/evidence search) is off by default.
MEDLEVO_ALLOW_EXTERNAL_FETCH=false

# --- Off-site backups to Cloudflare R2 (optional; docs/BACKUP_RESTORE.md §6, docs/DEPLOY_PHONE_AR.md) ---
# Each backup is verified on the server, then encrypted HERE (AES-256-GCM) before it is uploaded. Without every value
# below off-site backups stay off and the Control Center says what is missing. Secrets: never commit them.
# Cloudflare account id (32 hex characters) → https://<id>.r2.cloudflarestorage.com. MEDLEVO_R2_ENDPOINT overrides it
# (an EU-jurisdiction bucket: https://<id>.eu.r2.cloudflarestorage.com, or another S3-compatible store).
MEDLEVO_R2_ACCOUNT_ID=
MEDLEVO_R2_ENDPOINT=
MEDLEVO_R2_BUCKET=
# An R2 API token with «Object Read & Write» on this bucket only
MEDLEVO_R2_ACCESS_KEY_ID=
MEDLEVO_R2_SECRET_ACCESS_KEY=
# Object key prefix inside the bucket
MEDLEVO_R2_PREFIX=medlevo/
# 32 random bytes as base64 (44 characters) or 64 hex characters, e.g. `openssl rand -base64 32` (Render generates
# one). Keep a copy outside the server: LOSING THIS KEY MAKES EVERY OFF-SITE BACKUP UNREADABLE.
MEDLEVO_BACKUP_ENCRYPTION_KEY=
# Daily time in MEDLEVO_TIMEZONE (HH:MM, 24-hour) or "off" (then only «نسخ احتياطي الآن» in the Control Center)
MEDLEVO_BACKUP_SCHEDULE=03:15
# Retention in R2: the newest backup of each of the last N days and of each of the last M weeks
MEDLEVO_BACKUP_KEEP_DAILY=7
MEDLEVO_BACKUP_KEEP_WEEKLY=4
# Archives of off-site runs kept on the server disk after a successful upload (manual backups are never touched)
MEDLEVO_BACKUP_KEEP_LOCAL=1

# --- Advanced (optional) ---
# Which reverse proxies are trusted for the client address (sessions, login rate limiter). docs/DEPLOYMENT.md §3, §8.
#   false  no proxy: the client is the TCP peer (default)
#   true   every proxy — ONLY behind your own nginx / Caddy that OVERWRITES X-Forwarded-For with one address
#   <n>    the n proxy hops nearest the app (Render: 1); the client is the entry n places from the right
#   <list> addresses / CIDR ranges / loopback, linklocal, uniquelocal, comma-separated
MEDLEVO_TRUST_PROXY=false
# A header the platform's edge sets to the client address and that clients cannot forge through it
# (Render → Cloudflare: cf-connecting-ip). Honoured only from a trusted proxy (needs MEDLEVO_TRUST_PROXY).
MEDLEVO_CLIENT_IP_HEADER=
MEDLEVO_LOG_LEVEL=info
MEDLEVO_MAX_JSON_MB=8
MEDLEVO_MAX_ZIP_RATIO=100
# scrypt cost exponent (2^N). Keep the default (15) in production.
MEDLEVO_SCRYPT_LOG_N=15
MEDLEVO_JOB_CONCURRENCY=2
# Serve the built web app from this directory (production); empty = auto-detect apps/web/dist
MEDLEVO_WEB_DIST=
# Override LibreOffice detection for .doc/.ppt conversion: 1 = available, 0 = not available; empty = look for
# soffice/libreoffice on PATH. Without LibreOffice those formats are refused with a reason (never half-converted).
MEDLEVO_SOFFICE_AVAILABLE=
