// MedLevo on Cloudflare (Workers + Containers + R2). See deploy/cloudflare/README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "medlevo",
  "account_id": "37ff0d6a9c0fa8f1820f297cafa03923",
  "main": "deploy/cloudflare/worker.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "MedLevoContainer",
      "image": "./Dockerfile",
      "max_instances": 1,
      // the disk (20 GB) holds the data, one local archive and a restore during boot
      // 2 vCPU / 8 GB (owner asked for faster upload / open / save: OCR and page renders use both cores)
      "instance_type": { "vcpu": 2, "memory_mib": 8192, "disk_mb": 20000 },
      // close to the owner (Iraq): Middle East first, Eastern Europe as the fallback (it was placed in San Jose)
      "constraints": { "regions": ["ME", "EEUR"] },
      // the old instance gets time for its final R2 backup on SIGTERM (server: backupNowAndWait, ≤ 4 min)
      "rollout_active_grace_period": 300
    }
  ],
  "durable_objects": { "bindings": [{ "name": "MEDLEVO", "class_name": "MedLevoContainer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MedLevoContainer"] }],
  "vars": {
    "MEDLEVO_ORIGIN": "https://medlevo.aliamer59409.workers.dev",
    "MEDLEVO_R2_BUCKET": "medlevo-backups",
    "MEDLEVO_BACKUP_INTERVAL_MINUTES": "10",
    // the owner asked for no AI limit: every account and subject shares the (maximum) deployment budget
    "MEDLEVO_AI_MONTHLY_BUDGET_USD": "100000",
    "MEDLEVO_AI_OPEN_ALLOWANCE": "true",
    // the owner asked to stay signed in: a sign-in lasts 10 years without use (sign out / «الأجهزة» still revoke it)
    "MEDLEVO_SESSION_DAYS": "3650",
    // web reference images («صور من الويب»): a STRING read by the server's boolish parser ("true"/"1"/"yes"/"on" = on).
    // The server then calls only its fixed allow-list (Wikimedia Commons, NLM Open-i, Google CSE when keyed) over https.
    // Google is optional: `wrangler secret put GOOGLE_CSE_KEY` and set GOOGLE_CSE_ID here (both, or Google stays off).
    "MEDLEVO_ALLOW_EXTERNAL_FETCH": "true"
  }
}
