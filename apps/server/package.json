{
  "name": "@medlevo/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' tsx watch src/index.ts",
    "start": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' tsx src/index.ts",
    "test": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' vitest run",
    "typecheck": "tsc --noEmit",
    "backup": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' tsx src/cli/backup.ts",
    "restore:verify": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' tsx src/cli/restore-verify.ts",
    "eval": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' tsx src/cli/eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.1.2",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@medlevo/shared": "0.1.0",
    "@tesseract.js-data/ara": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "docx": "^9.7.1",
    "fastify": "^5.12.5",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "tesseract.js": "^7.0.0",
    "ts-fsrs": "^5.4.2",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
